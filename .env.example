# ==========================================
# CareFlow AI - Environment Configuration
# ==========================================

# Application
APP_NAME=CareFlow AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT
SECRET_KEY=careflow-super-secure-production-secret-key-change-me-in-prod-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite local development: sqlite:///./careflow.db
# For PostgreSQL production: postgresql://postgres:postgres@localhost:5432/careflow
DATABASE_URL=sqlite:///./careflow.db

# AI & LLM Provider Settings
# AI_PROVIDER can be 'gemini', 'openai', or 'smart_agent' (built-in autonomous capability engine)
AI_PROVIDER=smart_agent
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Mock EHR Integration Defaults
MOCK_EHR_DEFAULT_MODE=NORMAL
MOCK_EHR_SIMULATED_LATENCY_MS=300

# Notifications
NOTIFICATION_BACKEND=in_app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
